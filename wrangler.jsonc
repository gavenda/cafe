{
  "name": "cafe",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-15",
  "route": "cafe.gavenda.dev",
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "56c9226225f54cfdb1cc9d2a2a322e28",
      "remote": true
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    },
    "logs": {
      "enabled": true
    }
  },
  "triggers": {
    "crons": ["0 17 * * *", "5 17 * * 1"]
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_name": "cafe",
      "database_id": "51f7d27e-070f-4074-90b4-659f515a032a",
      "remote": true
    }
  ]
}
