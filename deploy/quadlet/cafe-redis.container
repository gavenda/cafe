[Unit]
Description=Redis for the cafe Discord bot

[Container]
ContainerName=cafe-redis
Pod=cafe.pod
Image=docker.io/library/redis:8-alpine
AutoUpdate=registry
# Fan snapshots are the only record of past totals, so persist every write.
# Listen on the pod's loopback only.
Exec=redis-server --appendonly yes --bind 127.0.0.1
Volume=cafe-redis.volume:/data
HealthCmd=redis-cli ping
HealthInterval=10s
HealthTimeout=3s
HealthRetries=5
# Report the unit as started only once Redis answers the health check.
Notify=healthy

[Service]
Restart=always
TimeoutStartSec=120
